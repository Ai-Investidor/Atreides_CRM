# Copie para .env.local e preencha.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google Agenda (só servidor)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 bytes em base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_KEY=

# Dados de mercado (só servidor). Sem a chave, o sistema usa só o Yahoo Finance.
BRAPI_TOKEN=
# Indicadores grátis em cadeia (só servidor). Dados B3 funciona sem chave (150/dia); com chave, 200/dia.
DADOSB3_API_KEY=
BOLSAI_API_KEY=
